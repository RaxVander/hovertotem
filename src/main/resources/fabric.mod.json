{
  "schemaVersion": 1,
  "id": "hovertotem",
  "version": "${version}",
  "name": "Hover Totem",
  "description": "Hover over a totem in your inventory to move it to your offhand and/or hotbar. Configurable delay, random delay range and mode.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.hovertotem.HoverTotemClient"],
    "modmenu": ["com.example.hovertotem.HoverTotemModMenu"]
  },
  "mixins": [
    { "config": "hovertotem.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
